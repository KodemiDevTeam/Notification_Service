{
  "info": {
    "name": "KodeMI Notification Service API",
    "description": "Comprehensive Postman collection for the production-ready KodeMI Notification Service. Features real-time SSE event streaming, mobile FCM token registration/deregistration, unread counts, and marking read/all-read.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Web SSE Stream Connection",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/stream/{{userId}}?token={{token}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "stream",
            "{{userId}}"
          ],
          "query": [
            {
              "key": "token",
              "value": "{{token}}"
            }
          ]
        },
        "description": "Establishes a Server-Sent Events (SSE) connection. In Postman, you can test this using the SSE connection panel. The token must be sent in the query parameter."
      },
      "response": []
    },
    {
      "name": "Register Mobile FCM Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"token\": \"fcm_token_from_device_example_12345\",\n    \"platform\": \"ANDROID\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/device-token/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "device-token",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Deregister Mobile FCM Token",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"token\": \"fcm_token_from_device_example_12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/device-token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "device-token"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get My Notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "me"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get My Unread Count",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/me/unread-count",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "me",
            "unread-count"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Mark One Read",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/{{notificationId}}/read",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "{{notificationId}}",
            "read"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Mark All Read",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/me/read-all",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "me",
            "read-all"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Send Direct (Immediate)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": \"{{userId}}\",\n    \"title\": \"Direct Message Example\",\n    \"message\": \"This is an immediate direct in-app notification.\",\n    \"type\": \"GENERAL\",\n    \"channel\": \"IN_APP\",\n    \"priority\": \"NORMAL\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/in-app",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "in-app"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://creepier-rachell-hooplike.ngrok-free.dev"
    },
    {
      "key": "token",
      "value": "paste_jwt_token_here"
    },
    {
      "key": "userId",
      "value": "sample_user_id"
    },
    {
      "key": "notificationId",
      "value": "sample_notification_id"
    }
  ]
}
